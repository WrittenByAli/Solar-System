# Copy to .env and fill in your own project values.
# Only VITE_-prefixed variables are exposed to the browser bundle —
# never put secret keys behind a VITE_ prefix.

# Supabase (Settings → API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Set to true only after Clerk is registered as a Supabase third-party
# auth provider (see supabase_rls.sql header) — otherwise leave unset.
# VITE_SUPABASE_THIRD_PARTY_AUTH=true

# Clerk (API Keys → Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR-PUBLISHABLE-KEY

# Server-side secrets (used only by local admin scripts, NEVER by the app;
# the browser bundle must never see these):
# SUPABASE_SERVICE_ROLE_KEY=
# CLERK_SECRET_KEY=
